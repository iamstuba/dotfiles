#!/opt/homebrew/bin/bash
# SketchyBar runs this on start and on --reload. Its scripts see SketchyBar's
# own environment plus NAME, SENDER and CONFIG_DIR, never what this file
# exports, so a script that needs more sets it itself or takes an argument.

source "$CONFIG_DIR/colors.sh"
plugins=$CONFIG_DIR/plugins

# 38 is the notch strip, which macOS keeps clear of windows. On top and
# opaque, so the native menu bar never shows through on a hover.
sketchybar --bar height=38 position=top y_offset=0 display=all topmost=on \
  color="$BAR_COLOR" border_width=0

sketchybar --default \
  icon.font="Symbols Nerd Font:Regular:14.0" icon.color="$FG" \
  label.font="Monaspace Neon:Regular:13.0" label.color="$FG" \
  padding_left=4 padding_right=4

# The device name differs between Macs, and ipconfig needs it.
wifi_device=$(networksetup -listallhardwareports \
  | awk '/^Hardware Port: Wi-Fi$/ { getline; print $2; exit }')

# The pills show their number as the icon and their apps as app-font
# ligatures in the label. The event loop colours them. AeroSpace sends no
# event for a window closing elsewhere, so workspace.1 also polls and redraws
# all five.
pills=()
for ws in 1 2 3 4 5; do
  pills+=(--add item "workspace.$ws" left
    --set "workspace.$ws" icon="$ws" icon.font="Monaspace Neon:Regular:13.0" icon.color="$GREY"
      icon.padding_left=8 icon.padding_right=8
      label.font="sketchybar-app-font:Regular:14.0" label.padding_left=0 label.padding_right=8
      label.drawing=off background.color="$PILL_BG" background.corner_radius=6
      background.height=24 click_script="aerospace workspace $ws")
done
sketchybar "${pills[@]}" \
  --set workspace.1 update_freq=10 script="$plugins/workspaces.sh" \
  --add item mode left \
  --set mode drawing=off label.color="$BAR_COLOR" label.padding_left=8 label.padding_right=8 \
    background.corner_radius=6 background.height=24

# Right items stack leftwards in the order added, so the clock is at the edge.
sketchybar \
  --add item clock right \
  --set clock update_freq=30 script="$plugins/clock.sh" \
  --add item wifi right \
  --set wifi update_freq=60 script="$plugins/wifi.sh $wifi_device" \
    click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" \
  --subscribe wifi wifi_change system_woke \
  --add item battery right \
  --set battery update_freq=120 script="$plugins/battery.sh" label.padding_left=3 \
  --subscribe battery power_source_change system_woke \
  --add item memory right \
  --set memory update_freq=15 script="$plugins/memory.sh" label.padding_left=3 \
  --add item cpu right \
  --set cpu update_freq=5 script="$plugins/cpu.sh" label.padding_left=3 \
  --add item watchdog right \
  --set watchdog drawing=off update_freq=10 script="$plugins/watchdog.sh"

# The loop starts after the items exist, since a --set on a missing item ends
# it. It ends an older copy of itself, so a reload leaves one.
"$plugins/aerospace_events.sh" &

sketchybar --update
