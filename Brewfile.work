# Homebrew packages for the work Mac only, installed after the shared Brewfile.

# Homebrew builds the docker CLI from source, and mise's docker-cli takes its
# first download on trust.
brew "docker"
# mise's aws-cli unpacks a .pkg that has no checksum, and mise never checks
# its signature. A codesign check after the install would cover one
# executable, not the Python files beside it. Homebrew pins the bottle's
# sha256. The cost is a Homebrew Python, and update:apps upgrades it, not
# update:tools.
brew "awscli"
# Only the work Mac uses gitlab.com.
brew "glab"
# Colima runs the docker engine in a Lima VM. The user starts and stops it by
# hand, so it runs only when asked. Lima on its own is the fallback runtime.
brew "colima"
brew "lima"
# docker loads both only from ~/.docker/cli-plugins, which mise.work.toml's
# setup-docker links to their opt paths.
brew "docker-compose"
brew "docker-buildx"
# On PATH, its osxkeychain helper makes docker login set credsStore and keep
# the token in the login keychain, not base64 in ~/.docker/config.json.
brew "docker-credential-helper"
brew "kubernetes-cli"
# Work repos render their charts locally with helm template. A repo's own mise
# pin wins inside it wherever mise is active.
brew "helm"
brew "k6"
# prost-build finds protoc on PATH, so the work overlay sets no PROTOC.
brew "protobuf"
# HashiCorp's own vault, the one the work repos run.
tap "hashicorp/tap"
brew "hashicorp/tap/vault"
