#!/usr/bin/env bash
# Find or kill the process listening on a port. From nicknisi/dotfiles at 5387d98.
# pt find 3000 prints the PID on stdout, details on stderr. pt kill 3000 kills it.

find_port() {
  local port=$1
  local pid
  pid=$(lsof -i -P -n | grep LISTEN | grep ":$port" | awk '{print $2}')
  if [[ -z "$pid" ]]; then
    echo >&2 "No process found listening on port $port"
    exit 0
  fi
  echo >&2 "Process listening on port $port:"
  echo >&2 "  PID:     $pid"
  echo >&2 "  User:    $(ps -p "$pid" -o user= 2>/dev/null)"
  echo >&2 "  CPU:     $(ps -p "$pid" -o %cpu= 2>/dev/null)%"
  echo >&2 "  Memory:  $(ps -p "$pid" -o %mem= 2>/dev/null)%"
  echo >&2 "  Started: $(ps -p "$pid" -o start= 2>/dev/null)"
  echo >&2 "  Command: $(ps -p "$pid" -o args= 2>/dev/null)"
  echo "$pid"
}

kill_port() {
  local port=$1
  local pid cmd
  pid=$(lsof -i -P -n | grep LISTEN | grep ":$port" | awk '{print $2}')
  if [[ -z "$pid" ]]; then
    echo >&2 "No process found listening on port $port"
    exit 0
  fi
  cmd=$(ps -p "$pid" -o args= 2>/dev/null)
  kill -9 "$pid"
  echo "Killed process on port $port:"
  echo "  PID:     $pid"
  echo "  Command: $cmd"
}

case "${1:-}" in
find | f)
  [[ -n "${2:-}" ]] || { echo "Usage: pt find <port>"; exit 1; }
  find_port "$2"
  ;;
kill | k)
  [[ -n "${2:-}" ]] || { echo "Usage: pt kill <port>"; exit 1; }
  kill_port "$2"
  ;;
*)
  echo "Usage: pt <find|kill> <port>"
  exit 1
  ;;
esac
