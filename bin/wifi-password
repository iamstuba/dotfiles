#!/usr/bin/env bash
# Print a Wi-Fi password from the keychain. From nicknisi/dotfiles at 5387d98.
# wifi-password [--system] [--quiet] [SSID]. Defaults to the current network.
set -euo pipefail

search_system_keychain=false
quiet_mode=false
target_ssid=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --system) search_system_keychain=true ;;
    --quiet) quiet_mode=true ;;
    *) target_ssid="$1" ;;
  esac
  shift
done

if [[ -z "$target_ssid" ]]; then
  target_ssid="$(networksetup -getairportnetwork en0 2>/dev/null | sed -n 's/Current Wi-Fi Network: //p')"
  if [[ -z "$target_ssid" ]]; then
    echo "Error: not connected to Wi-Fi or unable to detect the network" >&2
    exit 2
  fi
fi

try_keychain() {
  local password
  password="$("$@" 2>/dev/null)" || return 1
  [[ -n "$password" ]] || return 1
  printf "%s\n" "$password"
}

# Login keychain first: no popup.
if try_keychain security find-generic-password -D "AirPort network password" -a "$target_ssid" -gw; then
  exit 0
fi
if try_keychain security find-generic-password -s "$target_ssid" -gw; then
  exit 0
fi

if [[ "$search_system_keychain" == true ]]; then
  if try_keychain sudo security find-generic-password -D "AirPort network password" -a "$target_ssid" -gw; then
    exit 0
  fi
elif [[ "$quiet_mode" == false ]]; then
  echo "Password may be in the System keychain. Rerun with --system to query it (may prompt)." >&2
fi

exit 2
