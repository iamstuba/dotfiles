#!/bin/sh
# Personal post-defaults hook: deletes the bundled apps removable without
# touching SIP. Only mise.personal.toml runs it; the work Mac keeps them.
# --dry-run or DRY_RUN=1 prints.
set -eu

case "${1:-}" in
  "") ;;
  --dry-run) DRY_RUN=1 ;;
  *) echo "remove-bundled-apps: unknown argument $1" >&2; exit 1 ;;
esac
run() { if [ "${DRY_RUN:-}" ]; then printf '+ %s\n' "$*"; else "$@"; fi; }

# Pages, Numbers and Keynote ship as "<name> Creator Studio" since macOS 26.
for app in GarageBand iMovie Pages Numbers Keynote \
  "Pages Creator Studio" "Numbers Creator Studio" "Keynote Creator Studio"; do
  if [ -d "/Applications/$app.app" ]; then run rm -rf "/Applications/$app.app"; fi
done
# GarageBand's loops are root-owned, so these need sudo; nothing else in
# bootstrap does.
for dir in "/Library/Application Support/GarageBand" "/Library/Audio/Apple Loops"; do
  if [ -d "$dir" ]; then run sudo rm -rf "$dir"; fi
done
