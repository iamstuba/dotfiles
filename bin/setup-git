#!/bin/sh
# Local git identity, profiles and their signing keys, the GitHub SSH key, the
# work Mac's GitLab login and key, and SSH remotes. Run by `mise run setup-git`
# and by the installer. Rerunnable: every step skips what exists. --dry-run or
# DRY_RUN=1 prints.
set -eu

die() { echo "setup-git: $*" >&2; exit 1; }
case "${1:-}" in "") ;; --dry-run) DRY_RUN=1 ;; *) die "unknown argument $1" ;; esac
run() { if [ "${DRY_RUN:-}" ]; then printf '+ %s\n' "$*"; else "$@"; fi; }

DOTFILES=${DOTFILES:-$HOME/Projects/iamstuba/dotfiles}
github_key=$HOME/.ssh/id_ed25519_github
gitlab_key=$HOME/.ssh/id_ed25519_gitlab
scopes=admin:public_key,admin:ssh_signing_key

# Identity: environment first, prompts second, never a hang without a TTY.
ask() {
  eval "val=\${$1:-}"
  if [ -z "$val" ]; then
    [ -t 0 ] || die "$1 is unset and there is no terminal to ask"
    printf '%s: ' "$2"
    read -r val
  fi
  eval "$1=\$val"
}
ask GIT_NAME "Git name"
ask GIT_EMAIL "Git email"
if [ -z "${GIT_PROFILES+set}" ]; then
  GIT_PROFILES=
  if [ -t 0 ]; then
    printf 'Profiles as dir=email[=github|gitlab], comma separated, or empty: '
    read -r GIT_PROFILES
  fi
fi

# miserc decides the env, as it does for mise. The installer writes it before
# calling this, so a run by hand and a run from the installer agree.
if grep -qs '^env *=.*"work"' "$HOME/.config/mise/miserc.toml"; then
  machine_env=work
  default_key=$gitlab_key
else
  machine_env=personal
  default_key=$github_key
fi

# Sets dir, email, name and profile_key from one entry, or stops.
parse_profile() {
  dir=${1%%=*}
  rest=${1#*=}
  email=${rest%%=*}
  key_name=github
  [ "$dir" != "$1" ] && [ -n "$dir" ] && [ -n "$email" ] || die "profile '$1' is not dir=email"
  if [ "$email" != "$rest" ]; then
    key_name=${rest#*=}
    case "$key_name" in *=*) die "profile '$1' has more than three fields" ;; esac
  fi
  case "$key_name" in
    github) profile_key=$github_key ;;
    gitlab)
      [ "$machine_env" = work ] || die "profile '$1' names the GitLab key, which only the work Mac has"
      profile_key=$gitlab_key ;;
    *) die "profile '$1' names key '$key_name'; use github or gitlab" ;;
  esac
  name=$(basename "$dir" | tr '[:upper:]' '[:lower:]')
}

# Runs $1 once per entry with parse_profile's variables set. Globbing is off,
# so an entry holding * or ? stays as typed and never matches a file name.
each_profile() {
  old_ifs=$IFS
  IFS=,
  set -f
  for entry in $GIT_PROFILES; do
    IFS=$old_ifs
    entry=$(printf '%s' "$entry" | sed 's/^ *//; s/ *$//')
    [ -n "$entry" ] || continue
    parse_profile "$entry"
    "$1"
  done
  set +f
  IFS=$old_ifs
}

# Checked whole before any login, key or file, so a bad entry leaves the Mac as it was.
seen=
check_unique() {
  case " $seen " in *" $name "*) die "two profiles would share ~/.gitconfig-$name; rename one directory" ;; esac
  seen="${seen:-} $name"
}
each_profile check_unique

# -p ssh keeps gh out of git's credential config; the key upload is ours.
if ! gh auth status >/dev/null 2>&1; then
  run gh auth login -w -p ssh --skip-ssh-key -s "$scopes"
fi

make_key() {
  run mkdir -p "$HOME/.ssh"
  run ssh-keygen -t ed25519 -C "$GIT_EMAIL" -f "$1"
  run ssh-add --apple-use-keychain "$1"
}

# The installer normally made the key already, so the passphrase prompt came early.
[ -f "$github_key" ] || make_key "$github_key"

# Registered twice, once per use. GitHub refuses a duplicate, so check first.
pub=$(cut -d' ' -f2 "$github_key.pub" 2>/dev/null || true)
register() {
  if [ -n "$pub" ] && [ -z "${DRY_RUN:-}" ] && gh ssh-key list 2>/dev/null | grep -F "$pub" | grep -q "$1"; then
    return 0
  fi
  # A duplicate is success, a scope refusal earns one retry, anything else is fatal.
  if ! out=$(run gh ssh-key add "$github_key.pub" --type "$1" --title "$(hostname)" 2>&1); then
    case "$out" in
      *already*) ;;
      *scope* | *admin:*)
        run gh auth refresh -s "$scopes"
        run gh ssh-key add "$github_key.pub" --type "$1" --title "$(hostname)" ;;
      *) die "$out" ;;
    esac
  fi
  [ -z "$out" ] || printf '%s\n' "$out"
}
register authentication
register signing

# The work Mac's GitLab login and key, as the installer makes them. mise runs
# this inside the dotfiles clone, whose remote is github.com, so GITLAB_HOST
# pins the host for ssh-key, which takes no --hostname.
glab() {
  GLAB_CONFIG_DIR=$HOME/.config/glab-cli GLAB_SEND_TELEMETRY=0 GITLAB_HOST=gitlab.com command glab "$@"
}
if [ "$machine_env" = work ]; then
  # A login on a host with credentials always asks to re-authenticate, so check first.
  if [ -z "$(glab config get user --host gitlab.com 2>/dev/null || true)" ]; then
    run glab auth login --hostname gitlab.com --web -g ssh
  fi
  [ -f "$gitlab_key" ] || make_key "$gitlab_key"
  # glab lists 30 keys a page by default, so one page of 100 reads the whole
  # account. GitLab key fingerprints are unique across gitlab.com, so after a
  # full list a refused upload means another account holds this key, and
  # set -e stops here with glab's error.
  gitlab_pub=$(cut -d' ' -f2 "$gitlab_key.pub" 2>/dev/null || true)
  if [ -z "$gitlab_pub" ] || [ -n "${DRY_RUN:-}" ] \
    || ! glab ssh-key list --per-page 100 2>/dev/null | grep -qF "$gitlab_pub"; then
    run glab ssh-key add "$gitlab_key.pub" --title "$(hostname)" --usage-type auth_and_signing
  fi
fi

# Local files, never overwritten: identity is edited by hand after this.
write() {
  if [ -f "$1" ]; then
    echo "setup-git: $1 exists, left alone"
    cat >/dev/null
  elif [ "${DRY_RUN:-}" ]; then
    echo "+ write $1"
    sed 's/^/    /'
  else
    cat >"$1"
  fi
}

# Appended, never inserted: an include after [user] is what lets the profile
# win inside its directory.
append() {
  if [ "${DRY_RUN:-}" ]; then
    echo "+ append $1"
    sed 's/^/    /'
  else
    cat >>"$1"
  fi
}

local_config=$HOME/.gitconfig-local
includes=
write_profile() {
  printf '[user]\n\temail = %s\n\tsigningkey = %s.pub\n' "$email" "$profile_key" | write "$HOME/.gitconfig-$name"
  include="[includeIf \"gitdir/i:$dir/\"]
	path = ~/.gitconfig-$name"
  # An existing Mac gets the profiles it lacks; a fresh one gets them all at once below.
  if [ ! -f "$local_config" ]; then
    includes="$includes
$include"
  elif ! grep -qxF "[includeIf \"gitdir/i:$dir/\"]" "$local_config"; then
    printf '\n%s\n' "$include" | append "$local_config"
  fi
}
each_profile write_profile

printf '[user]\n\tname = %s\n\temail = %s\n\tsigningkey = %s.pub\n[commit]\n\tgpgsign = true\n%s\n' \
  "$GIT_NAME" "$GIT_EMAIL" "$default_key" "$includes" | write "$local_config"

# [user] is the owner's, so the work Mac still signing with another key gets a
# note and no edit. git signs with the key whether the path is spelled with ~
# or $HOME and names the private or the public half.
if [ "$machine_env" = work ] && [ -f "$local_config" ]; then
  signs=$(git config --file "$local_config" --get user.signingkey || true)
  resolved=$signs
  # shellcheck disable=SC2088  # matching the literal ~ a hand edit writes
  case "$resolved" in "~/"*) resolved=$HOME/${resolved#"~/"} ;; esac
  if [ "${resolved%.pub}" != "$gitlab_key" ]; then
    echo "setup-git: ~/.gitconfig-local signs with ${signs:-no key}; the work Mac signs with ~/.ssh/id_ed25519_gitlab.pub. Edit [user] by hand."
  fi
fi

run gh config set git_protocol ssh

# GitHub's published host keys, so the first unattended push never asks.
known_hosts=$HOME/.ssh/known_hosts
if ! grep -qs '^github.com ' "$known_hosts"; then
  if [ "${DRY_RUN:-}" ]; then
    echo "+ append github.com host keys from gh api meta to $known_hosts"
  else
    mkdir -p "$HOME/.ssh"
    gh api meta --jq '.ssh_keys[]' | sed 's/^/github.com /' >>"$known_hosts"
  fi
fi

# The installer cloned over HTTPS because no key existed yet. Only flip that exact URL.
if [ -d "$DOTFILES/.git" ]; then
  case "$(git -C "$DOTFILES" remote get-url origin 2>/dev/null || true)" in
    https://github.com/iamstuba/dotfiles | https://github.com/iamstuba/dotfiles.git)
      run git -C "$DOTFILES" remote set-url origin git@github.com:iamstuba/dotfiles.git ;;
  esac
fi

echo "setup-git: done"
